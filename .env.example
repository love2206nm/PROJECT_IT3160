# ==============================================================================
# AI Recruiter & Career Copilot - Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# --- Application Configuration ---
APP_NAME="AI Career Copilot"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000
API_V1_STR="/api/v1"
CORS_ORIGINS=["*"]

# --- LLM Providers & API Keys ---
# DeepSeek API Key (Chốt dùng cho Tier 1 Fast Extractor - deepseek-chat / OpenAI compatible)
DEEPSEEK_API_KEY="your-deepseek-or-openrouter-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
FAST_LLM_PROVIDER="deepseek"
FAST_LLM_MODEL="deepseek-chat"

# Google Gemini API Key (Fallback for Tier 1 & Primary for Tier 2 Reasoning Copilot)
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (Optional fallback if using GPT models)
OPENAI_API_KEY="your-openai-api-key-here"

# Reasoning Copilot Model Selection
REASONING_LLM_MODEL="gemini-1.5-pro"

# --- Storage & Data Paths ---
DATA_RAW_DIR="./data/raw_data"
DATA_CLEAN_DIR="./data/clean_data"
FAISS_INDEX_DIR="./models/faiss_index"

# --- Hybrid Router & ML Algorithm Parameters ---
# Router threshold: Confidence >= 0.90 -> Deterministic lookup, else ML XGBoost
ROUTER_CONFIDENCE_THRESHOLD=0.90

# Clustering: K=12 transition clusters
CLUSTERING_N_CLUSTERS=12

# Transition Utility Weights: Utility = w1*Similarity + w2*(1 - Threat/100) + w3*SalaryAdvantage
WEIGHT_SIMILARITY=0.50
WEIGHT_AI_SAFETY=0.35
WEIGHT_SALARY=0.15
SAFETY_MARGIN_DELTA=10.0

# --- RAG & LangGraph Parameters ---
RAG_TOP_K=5
MAX_CRITIC_ITERATIONS=2
